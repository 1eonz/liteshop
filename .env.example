# LiteShop 环境变量模板
# 复制为 .env.development / .env.staging / .env.production 并填入实际值

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://liteshop:liteshop@localhost:5432/liteshop_dev
DATABASE_READ_URL=postgresql+asyncpg://liteshop:liteshop@localhost:5432/liteshop_dev

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT 认证 =====
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST=12

# ===== 支付（沙箱） =====
PAYMENT_MODE=sandbox
# 微信支付沙箱
WECHAT_SANDBOX_MCH_ID=your-sandbox-mch-id
WECHAT_SANDBOX_API_KEY=your-sandbox-api-key
WECHAT_SANDBOX_CERT_PATH=./certs/sandbox/
# 支付宝沙箱
ALIPAY_SANDBOX_APP_ID=your-sandbox-app-id
ALIPAY_SANDBOX_PRIVATE_KEY=your-sandbox-private-key
ALIPAY_SANDBOX_PUBLIC_KEY=your-sandbox-public-key

# ===== 支付（正式，部署时注入） =====
# PAYMENT_MODE=production
# WECHAT_MCH_ID=...
# WECHAT_API_KEY=...
# WECHAT_CERT_PATH=/data/certs/production/
# ALIPAY_APP_ID=...
# ALIPAY_PRIVATE_KEY=...
# ALIPAY_PUBLIC_KEY=...

# ===== OSS 对象存储 =====
OSS_PROVIDER=aliyun
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=liteshop-dev
OSS_REGION=oss-cn-hangzhou
OSS_CDN_DOMAIN=https://cdn.liteshop.local
OSS_CALLBACK_URL=http://localhost:8000/api/v1/upload/callback

# ===== 短信 =====
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=LiteShop
SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# ===== 邮件 =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=noreply@liteshop.com
SMTP_PASSWORD=your-smtp-password

# ===== 官网 ISR（二期） =====
NEXTJS_BASE_URL=http://localhost:3000
REVALIDATE_TOKEN=your-revalidate-token

# ===== Sentry 错误监控 =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ===== 应用 =====
APP_VERSION=0.1.0-dev
ENV=development
LOG_LEVEL=DEBUG

# ===== 前端 =====
# H5
VITE_API_BASE=http://localhost:8000/api/v1
VITE_SENTRY_DSN=
# Admin
VITE_ADMIN_API_BASE=http://localhost:8000/api/v1
# 官网（二期）
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=

# ===== 限流 =====
RATE_LIMIT_SMS_PHONE_PER_DAY=5
RATE_LIMIT_LOGIN_USER_PER_5MIN=5
RATE_LIMIT_ORDER_USER_PER_MIN=10
