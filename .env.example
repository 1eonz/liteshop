# LiteShop 环境变量模板
# 复制为 .env.development / .env.staging / .env.production 并填入实际值

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://liteshop:liteshop@localhost:5432/liteshop_dev
DATABASE_READ_URL=postgresql+asyncpg://liteshop:liteshop@localhost:5432/liteshop_dev
# 连接池（生产必调，开发默认即可）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_TIMEOUT=5

# ===== CORS / Cookie =====
# 前后端分离必备，逗号分隔多域名，生产环境必须收紧为真实域名
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===== 加密密钥 =====
# 敏感字段加密（手机号/身份证/联系表单，PRD D5），32 字节 base64 字符串
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# 旧密钥轮换期可填多把，逗号分隔，第一把用于加密，其余用于解密
FIELD_ENCRYPTION_KEY_LEGACY=

# ===== JWT 认证 =====
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST=12

# ===== 支付（沙箱） =====
PAYMENT_MODE=sandbox
# 支付回调 URL（外网可达，生产必须为真实域名 + HTTPS）
PAYMENT_NOTIFY_BASE_URL=http://localhost:8000
# 微信支付沙箱
WECHAT_SANDBOX_MCH_ID=your-sandbox-mch-id
WECHAT_SANDBOX_API_KEY=your-sandbox-api-key
WECHAT_SANDBOX_CERT_PATH=./certs/sandbox/
WECHAT_SANDBOX_NOTIFY_URL=http://localhost:8000/api/v1/payments/wechat/callback
# 支付宝沙箱
ALIPAY_SANDBOX_APP_ID=your-sandbox-app-id
ALIPAY_SANDBOX_PRIVATE_KEY=your-sandbox-private-key
ALIPAY_SANDBOX_PUBLIC_KEY=your-sandbox-public-key
ALIPAY_SANDBOX_NOTIFY_URL=http://localhost:8000/api/v1/payments/alipay/callback
ALIPAY_SANDBOX_RETURN_URL=http://localhost:5173/payment/return

# ===== 支付（正式，部署时注入） =====
# PAYMENT_MODE=production
# WECHAT_MCH_ID=...
# WECHAT_API_KEY=...
# WECHAT_CERT_PATH=/data/certs/production/
# WECHAT_NOTIFY_URL=https://api.liteshop.com/api/v1/payments/wechat/callback
# ALIPAY_APP_ID=...
# ALIPAY_PRIVATE_KEY=...
# ALIPAY_PUBLIC_KEY=...
# ALIPAY_NOTIFY_URL=https://api.liteshop.com/api/v1/payments/alipay/callback
# ALIPAY_RETURN_URL=https://m.liteshop.com/payment/return

# ===== OSS 对象存储 =====
OSS_PROVIDER=aliyun
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=liteshop-dev
OSS_REGION=oss-cn-hangzhou
OSS_CDN_DOMAIN=https://cdn.liteshop.local
OSS_CALLBACK_URL=http://localhost:8000/api/v1/upload/callback
# OSS 内网 Endpoint（生产 ECS 走内网省流量，开发留空）
OSS_INTERNAL_ENDPOINT=

# ===== 文件上传限制 =====
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# ===== 短信 =====
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=LiteShop
SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# ===== 邮件 =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=noreply@liteshop.com
SMTP_PASSWORD=your-smtp-password

# ===== 官网 ISR（二期） =====
NEXTJS_BASE_URL=http://localhost:3000
REVALIDATE_TOKEN=your-revalidate-token

# ===== Sentry 错误监控 =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ===== 应用 =====
APP_VERSION=0.1.0-dev
ENV=development
NODE_ENV=development
LOG_LEVEL=DEBUG
# 日志文件路径（不填则只输出 stdout）
LOG_FILE_PATH=./logs/app.log
LOG_ROTATION_MAX_MB=100
LOG_ROTATION_BACKUP_COUNT=10

# ===== 管理员初始化 =====
# 首次部署时自动创建的超管账号，创建后请立即改密并清空这两个变量
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-this-immediately

# ===== 验证码（CAPTCHA） =====
# 登录/注册防刷，留空则不启用
CAPTCHA_PROVIDER=aliyun
CAPTCHA_APP_KEY=
CAPTCHA_APP_SECRET=

# ===== 主题模式 =====
# light / dark / auto（跟随系统，二期完整支持）
THEME_MODE=light

# ===== 前端 =====
# H5
VITE_API_BASE=http://localhost:8000/api/v1
VITE_SENTRY_DSN=
# Admin
VITE_ADMIN_API_BASE=http://localhost:8000/api/v1
# 官网（二期）
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=

# ===== 限流 =====
RATE_LIMIT_SMS_PHONE_PER_DAY=5
RATE_LIMIT_LOGIN_USER_PER_5MIN=5
RATE_LIMIT_LOGIN_IP_PER_HOUR=20
RATE_LIMIT_ORDER_USER_PER_MIN=10
RATE_LIMIT_API_ANONYMOUS_PER_MIN=60

# ===== SSE（实时通知，1b 期，E6；无 WebSocket——通知全链路走 SSE） =====
SSE_HEARTBEAT_INTERVAL=30
